{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // "Run Without Debugging" (Ctrl+F5) will:
      //   1. run the "serve-static" task => python -m http.server 5500
      //   2. open http://localhost:5500/ in the browser
      "type": "msedge",
      "request": "launch",
      "name": "Run CUBB (static server :5500)",
      "url": "http://localhost:5500/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve-static"
    },
    {
      // Fallback for users whose default debug browser is Chrome.
      "type": "chrome",
      "request": "launch",
      "name": "Run CUBB (Chrome, static server :5500)",
      "url": "http://localhost:5500/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve-static"
    }
  ]
}
